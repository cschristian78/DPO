<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DPO</RootNamespace>
    <AssemblyName>DPO</AssemblyName>
  </PropertyGroup>

  <Target Name="StopLockedApp" BeforeTargets="Build">
    <Exec Command="cmd /c &quot;taskkill /F /IM DPO.exe /T &gt;nul 2&gt;&amp;1 &amp; exit /b 0&quot;" />
  </Target>

</Project>
